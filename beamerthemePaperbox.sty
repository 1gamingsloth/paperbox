\ProvidesPackage{Paperbox}[2026-08-12 Simple Gruvbox Light-inspired theme]

\RequirePackage{xcolor}
\RequirePackage{listings}


% Fonts
\renewcommand{\familydefault}{\ttdefault}


% Colours
\definecolor{background}{HTML}{F5EFDA}
\definecolor{foreground}{HTML}{3C3836}
\definecolor{code-bg}{HTML}{EAE3CD}
\definecolor{code-text}{HTML}{6A733D}

% Semantic colours
\definecolor{theme-green}{HTML}{98971A}   % Functions
\definecolor{theme-yellow}{HTML}{D79921}  % Information
\definecolor{theme-blue}{HTML}{458588} 
\definecolor{theme-red}{HTML}{CC241D}     % Warnings
\definecolor{theme-orange}{HTML}{D65D0E}
\definecolor{theme-aqua}{HTML}{689D6A}

\definecolor{line-number}{HTML}{A89984}

% General colours
\setbeamercolor{normal text}{
    fg=foreground,
    bg=background
  }

\setbeamercolor{block title}{
    fg=background,
    bg=theme-aqua
  }

\setbeamercolor{block body}{
    fg=foreground,
    bg=background
}

\setbeamercolor{structure}{
    fg=foreground
}

\setbeamercolor{background canvas}{
    bg=background
}

% Remove navigation symbols
\setbeamertemplate{navigation symbols}{}

% Better lists
\setbeamertemplate{itemize item}{
    {\color{theme-green}\texttt{>}}
}

\setbeamertemplate{itemize subitem}{
    {\color{theme-aqua}\texttt{-}}
}

% codebox
\lstset{
    backgroundcolor=\color{code-bg},
    basicstyle=\color{foreground}\ttfamily\small,
    keywordstyle=\color{theme-red}\bfseries,
    stringstyle=\color{theme-green},
    commentstyle=\color{theme-blue}\itshape,
    frame=single,
    rulecolor=\color{code-bg},
    framesep=15pt,
    numbers=left,
    numberstyle=\tiny\color{line-number},
    numbersep=5pt,
    breaklines=true,
    columns=fullflexible,
    aboveskip=1em,
    belowskip=1em,
    showstringspaces=false
}

% Footline

\setbeamertemplate{footline}{
    \hspace{1em}
    \usebeamerfont{author in head/foot}
    \insertshortauthor
    \hfill
    \insertframenumber{} / \inserttotalframenumber
    \hspace{1em}
    \vspace{0.5em}
  }
  
\endinput
